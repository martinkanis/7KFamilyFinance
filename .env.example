# Lokální vývoj – zkopíruj do .env (ten se necommituje).
DATABASE_URL=postgresql://kkff:kkff-local@127.0.0.1:5433/kkff

# Kdo se smí přihlásit: jmeno:hash,jmeno:hash
# Hash vygeneruješ příkazem `bun run auth:hash-password` (heslo se nikam neukládá).
AUTH_USERS=

# Volitelné – bez něj si aplikace vygeneruje tajemství sama a uloží ho do DB.
# AUTH_SESSION_SECRET=
