{
  "name": "@kkff/api",
  "private": true,
  "type": "module",
  "exports": {
    "./contracts": "./src/contracts.ts",
    "./accountTypes": "./src/domain/accountTypes.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "start": "NODE_ENV=production bun run ./dist/index.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "auth:hash-password": "bun run src/scripts/hashPassword.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "env-var": "^7.5.0",
    "exceljs": "^4.4.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
